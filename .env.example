# Copy to .env and fill in from Firebase Console > Project settings > Your apps (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI assistant (optional — if the key is set here, users won't be asked for one in the UI)
VITE_OPENAI_API_KEY=
# Model to use (default: gpt-4o-mini)
VITE_OPENAI_MODEL=
# Point at any OpenAI-compatible backend (Azure OpenAI, Ollama, LM Studio, vLLM, OpenRouter...)
# e.g. http://localhost:11434/v1 for Ollama
VITE_OPENAI_BASE_URL=
